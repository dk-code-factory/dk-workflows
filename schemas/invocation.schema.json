    "plan": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/invocation"
          },
          {
            "type": "object",
            "properties": {
              "parallel": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/invocation"
                }
              }
            },
            "required": [
              "parallel"
            ],
            "additionalProperties": false
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/invocation"
            },
            "deprecated": true
          }
        ]
      }
    },
    "behavior": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "override": {
            "anyOf": [
              {
                "$ref": "#/$defs/instructions"
              },
              {
                "type": "null"
