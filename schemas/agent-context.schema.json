{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dk-code-factory/dk-workflows/main/schemas/agent-context.schema.json",
  "title": "Agent context document",
  "description": "Proposed per-agent context document; see docs/agent-context.md. Item bodies are owner-defined.",
  "type": "object",
  "properties": {
    "governing": {"$ref": "#/$defs/items", "propertyNames": {"pattern": "^/?(instruction|decision)/"}},
    "execution": {
      "type": "object",
      "properties": {
        "native_review": {
          "type": "object",
          "properties": {
            "passes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
          },
          "required": ["passes"],
          "additionalProperties": false
        }
      },
      "required": ["native_review"],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/task_id"},
        "instructions": {"type": "string", "minLength": 1},
        "material": {"$ref": "#/$defs/items"}
      },
      "required": ["id", "instructions"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/address"},
      "additionalProperties": {
        "description": "Small fields copied verbatim from the owner's stored item; hints only.",
        "type": "object",
        "maxProperties": 4,
        "additionalProperties": {"type": ["string", "number", "boolean"]}
      }
    }
  },
  "required": ["task"],
  "additionalProperties": false,
  "$defs": {
    "address": {
      "description": "Full (leading /) or short address, optionally followed by # and an RFC 6901 pointer.",
      "type": "string",
      "anyOf": [
        {"pattern": "^/(instruction|decision|evidence)/(global|repo/[a-z0-9.-]+/[a-z0-9_.-]+/[a-z0-9_.-]+|pr/[a-z0-9.-]+/[a-z0-9_.-]+/[a-z0-9_.-]+/[1-9][0-9]*|run/[a-z0-9.-]+/[a-z0-9_.-]+/[a-z0-9_.-]+/[1-9][0-9]*/[A-Za-z0-9._~:@+-]+)(/([A-Za-z0-9._~:@+-]|%[0-9A-F]{2})+)+(#(/([^/~]|~[01])*)*)?$"},
        {"pattern": "^(instruction|decision|evidence)/(global|repo|pr|run)(/([A-Za-z0-9._~:@+-]|%[0-9A-F]{2})+)+(#(/([^/~]|~[01])*)*)?$"}
      ]
    },
    "task_id": {
      "description": "Full task address; the owner segments of every short address come from it.",
      "type": "string",
      "pattern": "^/task/(pr/[a-z0-9.-]+/[a-z0-9_.-]+/[a-z0-9_.-]+/[1-9][0-9]*|run/[a-z0-9.-]+/[a-z0-9_.-]+/[a-z0-9_.-]+/[1-9][0-9]*/[A-Za-z0-9._~:@+-]+)(/[A-Za-z0-9._~:@+-]+)+$"
    },
    "items": {
      "description": "Address to complete owner item. Items are never references or partial copies.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/address"},
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "not": {"anyOf": [{"required": ["$ref"]}, {"required": ["truncated"]}]}
      }
    }
  }
}
