{
  "$schema": "./config.schema.json",
  "tasks": [
    {
      "skill": "dk-workflows:dk-pr-feedback-read",
      "options": {},
      "required": true
    },
    {
      "skill": "dk-workflows:dk-pr-reviewers-run",
      "options": {},
      "required": true
    },
    {
      "instructions": "Independently verify candidate findings against pinned source and governing instructions. Return confirmed, rejected or uncertain findings with evidence. Do not edit, publish or recursively invoke the review workflow.",
      "options": {},
      "required": true
    },
    {
      "skill": "dk-workflows:dk-pr-review-post",
      "options": {},
      "required": true
    }
  ],
  "finalizers": [
    {
      "skill": "dk-workflows:dk-ci-approve",
      "options": {},
      "required": true
    },
    {
      "skill": "dk-workflows:dk-ci",
      "options": {},
      "required": true
    },
    {
      "skill": "dk-workflows:dk-pr-publish",
      "options": {},
      "required": true
    }
  ],
  "limits": {
    "review_cycles": 5,
    "retries_per_task": 1,
    "ci_repairs_per_cycle": 5,
    "ci_reruns_per_head": 3
  },
  "permissions": {
    "push_commits": false,
    "rewrite_commits": false,
    "edit_pr": false,
    "reply_to_feedback": false,
    "resolve_threads": false,
    "create_draft_prs": false,
    "request_review": false,
    "post_review": true,
    "approve_fork_ci": true,
    "approve_pr": false,
    "merge_pr": {
      "enabled": false,
      "method": "squash"
    },
    "edit_architecture_decisions": true
  },
  "architecture": {
    "enabled": true,
    "review_skill": "dk-workflows:dk-architecture-review",
    "scoring": {
      "profile": "auto",
      "profile_selection_prompt": "Assess new features, existing behavior, tests, CI and maintenance. Choose a built-in scoring profile and explain why its trade-offs fit these circumstances.",
      "custom_prompt": null
    },
    "auto_pick": {
      "enabled": true,
      "prompt": "Assess confidence and sensitivity to LOC and complexity estimates. Accept a clear winner only with supported feasibility, adequate score lead and no unresolved material doubts. For a sole feasible option substantiate rejection of every alternative.",
      "min_score_gap": 10
    }
  },
  "simplification": {
    "enabled": true,
    "priority": "change-first",
    "allow_untouched_code": false,
    "reviewer": {
      "skill": "dk-workflows:dk-code-simplify",
      "options": {},
      "required": true
    }
  }
}
