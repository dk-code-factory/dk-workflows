{
  "$schema": "../schemas/config.schema.json",
  "schema_version": 1,
  "accounts": {
    "personal": []
  },
  "skill_defaults": {},
  "processes": {
    "pr-iter": {
      "coordinator": "dk-pr-iter",
      "routes": {
        "own_pr": "pr-fix",
        "other_pr": "pr-review"
      }
    },
    "pr-fix": {
      "coordinator": "dk-pr-fix",
      "tasks": {
        "read_feedback": "dk-pr-feedback-read",
        "collect_decisions": "dk-pr-decisions",
        "address_feedback": "dk-pr-feedback-address",
        "split_scope": "dk-pr-split",
        "review_changes": "dk-pr-reviewers-run",
        "organize_commits": "dk-commit-split",
        "draft_commit_message": "dk-commit-message",
        "update_description": "dk-pr-description",
        "reply_to_feedback": "dk-pr-feedback-reply",
        "check_ci": "dk-ci",
        "classify_ci_failures": "dk-ci-flakes",
        "publish_pr_actions": "dk-pr-publish"
      },
      "limits": {
        "review_cycles": 5,
        "retries_per_task": 1,
        "ci_repairs_per_cycle": 5,
        "ci_reruns_per_head": 3
      },
      "finalizers": [
        "dk-commit-split",
        "dk-pr-decisions",
        "dk-pr-description",
        "dk-pr-feedback-reply",
        "dk-ci",
        "dk-pr-publish"
      ],
      "permissions": {
        "push_commits": true,
        "rewrite_commits": true,
        "edit_pr": true,
        "reply_to_feedback": true,
        "resolve_threads": true,
        "create_draft_prs": true,
        "request_review": true,
        "post_review": false,
        "approve_fork_ci": false,
        "approve_pr": false,
        "merge_pr": {
          "enabled": false,
          "method": "squash"
        }
      },
      "hooks": {
        "before_cycle": [],
        "after_cycle": []
      }
    },
    "pr-review": {
      "coordinator": "dk-pr-review",
      "tasks": {
        "read_feedback": "dk-pr-feedback-read",
        "review_changes": "dk-pr-reviewers-run",
        "verify_findings": {
          "skill": "dk-pr-review",
          "instructions": "Independently verify candidate findings against pinned source and governing instructions. Return confirmed, rejected or uncertain findings with evidence. Do not edit or publish."
        },
        "post_review": "dk-pr-review-post",
        "approve_fork_ci": "dk-ci-approve",
        "check_ci": "dk-ci",
        "classify_ci_failures": "dk-ci-flakes",
        "publish_pr_actions": "dk-pr-publish"
      },
      "limits": {
        "review_cycles": 5,
        "retries_per_task": 1,
        "ci_repairs_per_cycle": 5,
        "ci_reruns_per_head": 3
      },
      "permissions": {
        "push_commits": false,
        "rewrite_commits": false,
        "edit_pr": false,
        "reply_to_feedback": false,
        "resolve_threads": false,
        "create_draft_prs": false,
        "request_review": false,
        "post_review": true,
        "approve_fork_ci": true,
        "approve_pr": false,
        "merge_pr": {
          "enabled": false,
          "method": "squash"
        }
      },
      "hooks": {
        "before_cycle": [],
        "after_cycle": []
      }
    },
    "commit-message": {
      "coordinator": "dk-commit-message"
    },
    "issue": {
      "coordinator": "dk-issue"
    },
    "pr-reviewers-run": {
      "coordinator": "dk-pr-reviewers-run"
    }
  },
  "extensions": {}
}
