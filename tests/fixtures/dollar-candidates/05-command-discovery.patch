+#!/usr/bin/env python3
+"""Read-only, versioned bookkeeping reference generated from the CLI parser."""
+import argparse
+import inspect
+import json
+from pathlib import Path
+
+from dk import make_parser, make_spec
+
+
+def arguments(parser):
+    result = []
+    for action in parser._actions:
+        if isinstance(action, (argparse._HelpAction, argparse._SubParsersAction)):
+            continue
+        item = {'flags': action.option_strings, 'name': action.dest,
+                'required': action.required,
+                'type': getattr(action.type, '__name__', 'string'),
+                'repeatable': isinstance(action, argparse._AppendAction)}
+        if action.nargs == 0:
+            item['type'] = 'boolean'
+        if action.choices is not None:
+            item['choices'] = list(action.choices)
+        if action.default is not None:
+            item['default'] = action.default
+        if action.help:
+            item['help'] = action.help
+        result.append(item)
+    return result
+
+
+def examples():
+    common = {'resources': {'skill': 'skill.md'}, 'instructions': {'user': 'instructions.txt'},
+              'inputs': {'context': 'context.json'}, 'options': {},
+              'governing_inputs_complete': True}
+    ordinary = dict(common, skill_identity='example:review', responsibility='content-review',
+                    assigned_instructions='Review the supplied scope and retain original findings.')
+    hook = dict(common, skill_identity='dk-workflows:dk-pr-fix')
+    finalizer = dict(common, skill_identity='example:finalizer',
+                     assigned_instructions='Validate the supplied finalization scope.')
+    prefix = ['--repository', 'github.com/example/project', '--pr',
+              'https://github.com/example/project/pull/7']
+    return {'argv_prefix': prefix,
+            'files': {'ordinary.json': ordinary, 'hook.json': hook, 'finalizer.json': finalizer},
+            'configuration': {'cycle_hooks': {'before_cycle': [
+                {'id': 'audit', 'instructions': 'Assess the supplied cycle scope.'}]},
+                'finalizers': ['/skill/example:finalizer']},
+            'commands': {
+                'spec': ['spec', '--definition', 'ordinary.json'],
+                'hook-spec': ['hook-spec', '--definition', 'hook.json', '--phase', 'before_cycle',
+                              '--hook-id', 'audit', '--run', 'run', '--cycle', 'c1'],
+                'finalizer-plan': ['finalizer-plan'],
+                'finalizer-spec': ['finalizer-spec', '--definition', 'finalizer.json',
+                                   '--finalizer', '/skill/example:finalizer', '--run', 'run'],
+                'resume': ['resume', '--run', 'run', '--spec', 'spec.json'],
+                'status': ['status', '--compact', '--spec', 'spec.json', '--run', 'run'],
+                'start': ['start', '--spec', 'spec.json', '--run', 'run'],
+                'start-batch': ['start-batch', '--spec', 'a.json', '--spec', 'b.json', '--run', 'run'],
+                'record': ['record', '--spec', 'spec.json', '--claim', 'CLAIM_FROM_START',
+                           '--original', 'original.txt', '--normalized', 'normalized.json',
+                           '--status', 'complete'],
+                'invalidate': ['invalidate', '--key', 'KEY_FROM_STATUS', '--reason', 'Changed scope']},
+            'usage': ['Substitute canonical identity and real private resource paths; include all governing inputs.',
+                      'Save generated spec stdout as spec.json outside the checkout.',
+                      'Configure hook/finalizer entries through scripts/config.py before generating their specs.',
+                      'For hooks/finalizers claim with --run only, without reviewer cycle or budget flags.',
+                      'Agents invoke skills between start and record; use the returned claim id.',
+                      'Reuse action from start requires no invocation. Recovery requires explicit authorization.',
+                      'Original output is exact skill output. normalized.json contains completion, findings and evidence.']}
+
+
+def reference(command=None):
+    parser = make_parser()
+    sub = next(a for a in parser._actions if isinstance(a, argparse._SubParsersAction))
+    if command is not None and command not in sub.choices:
+        raise ValueError('Unknown command: ' + command)
+    sample = examples()
+    # Keep examples synchronized with the supported argument grammar.
+    for argv in sample['commands'].values():
+        parser.parse_args(sample['argv_prefix'] + argv)
+    names = [command] if command else list(sub.choices)
+    required = [name for name, p in inspect.signature(make_spec).parameters.items()
+                if p.default is inspect.Parameter.empty and name not in ('repository', 'pr')]
+    return {'reference_version': 1,
+            'package_version': json.loads((Path(__file__).resolve().parents[1]/
+                                          '.codex-plugin/plugin.json').read_text())['version'],
+            'global_arguments': arguments(parser),
+            'commands': {name: arguments(sub.choices[name]) for name in names},
+            'ordinary_definition_required': required,
+            'examples': {**sample, 'commands': {name: sample['commands'][name] for name in names}},
+            'limits': 'Bookkeeping only. Examples do not authorize invocation, recovery or publication.'}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--command', help='Select one command instead of the full reference')
+    args = parser.parse_args()
+    try:
+        print(json.dumps(reference(args.command), sort_keys=True))
+    except ValueError as exc:
+        parser.error(str(exc))
+
+
+if __name__ == '__main__':
+    main()
