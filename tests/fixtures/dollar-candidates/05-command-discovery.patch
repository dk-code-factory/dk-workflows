@@ -0,0 +1,59 @@
+"""Generated discovery remains read-only and its examples work with real helpers."""
+from copy import deepcopy
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT/'scripts'))
+import dk_reference
+import config
+from state import Store, make_spec, write
+
+
+def test_reference_uses_live_parser_and_selects_commands_without_state(tmp_path, monkeypatch):
+    monkeypatch.setenv('XDG_STATE_HOME', str(tmp_path/'state'))
+    value = dk_reference.reference()
+    assert value['reference_version'] == 1
+    assert value['package_version'] == json.loads((ROOT/'.codex-plugin/plugin.json').read_text())['version']
+    assert len(value['commands']) == 10
+    assert next(a for a in value['commands']['record'] if a['name'] == 'status')['choices'] == [
+        'complete', 'failed', 'incomplete']
+    assert next(a for a in value['commands']['start-batch'] if a['name'] == 'spec')['repeatable']
+    assert list(dk_reference.reference('hook-spec')['commands']) == ['hook-spec']
+    with pytest.raises(ValueError, match='Unknown command'):
+        dk_reference.reference('execute')
+    output = subprocess.check_output([sys.executable, str(ROOT/'scripts/dk_reference.py'),
+                                      '--command', 'record'], text=True, cwd=tmp_path)
+    assert json.loads(output)['commands']['record'] == value['commands']['record']
+    assert not (tmp_path/'state').exists()
+
+
+def test_examples_complete_ordinary_hook_and_finalizer_without_reviewer_budgets(tmp_path):
+    sample = deepcopy(dk_reference.examples())
+    repository = 'github.com/example/project'
+    pr = 'https://github.com/example/project/pull/7'
+    write(config.path(repository), sample['configuration'])
+    for definition in sample['files'].values():
+        for field in ('resources', 'instructions', 'inputs'):
+            for label, name in definition[field].items():
+                path = tmp_path/name
+                path.write_text('Explicit example resource and governing context.')
+                definition[field][label] = str(path)
+    ordinary = make_spec(repository=repository, pr=pr, **sample['files']['ordinary.json'])
+    hook = config.make_hook_spec(repository=repository, pr=pr, run='run', cycle='c1',
+        phase='before_cycle', hook_id='audit', definition=sample['files']['hook.json'])
+    finalizer = config.make_finalizer_spec(repository=repository, pr=pr, run='run',
+        finalizer='/skill/example:finalizer', definition=sample['files']['finalizer.json'])
+    store = Store(repository, pr)
+    for task in (ordinary, hook, finalizer):
+        claim = store.start(task, run='run')['claim']
+        store.record(task, claim['id'], b'Original native output.',
+                     {'complete': True, 'findings': []}, 'complete')
+        assert store.start(task, run='run')['action'] == 'reuse'
+    run = store.status([ordinary, hook, finalizer])['runs']['run']
+    assert run['cycles'] == []
+    assert all(not run.get(k) for k in ('retries', 'ci_repairs', 'ci_reruns'))
