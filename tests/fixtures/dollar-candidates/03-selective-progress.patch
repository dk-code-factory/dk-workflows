diff --git a/tests/test_selective_progress.py b/tests/test_selective_progress.py
new file mode 100644
--- /dev/null
+++ b/tests/test_selective_progress.py
@@ -0,0 +1,82 @@
+"""Progress cursors preserve exact evidence, ownership, append positions and views."""
+import base64
+from copy import deepcopy
+from pathlib import Path
+import pytest
+from test_state import case
+import state
+
+
+def recorded(store, spec, progress, *, run='run'):
+    claim = store.start(spec,run=run)['claim']
+    store.record(spec,claim['id'],b'Original findings\x00\r\n',
+                 {'complete':True,'findings':[{'id':'F1','source':'original'}]},'complete',progress=progress)
+    return claim
+
+
+def test_cursor_filter_append_and_original_artifacts(case):
+    spec,store=case
+    exact={'acceptance':'Keep the original spelling.\r\n','source':spec['pr']+'#issuecomment-9'}
+    first=recorded(store,spec,exact)
+    other=deepcopy(spec);other['task']['id']='other'
+    recorded(store,other,{'unrelated':'retained'})
+    before=store.manifest.read_bytes()
+    key=first['key']
+    page=store.progress(run='run',task=key,limit=1)
+    assert page['items'][0]['progress']['value']==exact
+    drained=store.progress(run='run',task=key,after=page['next_cursor'])
+    assert drained['end_reached'] and drained['items']==[]
+    assert store.manifest.read_bytes()==before
+    with store.locked() as manifest:
+        manifest['runs']['run']['progress'].append({'claim':first['id'],'value':{'new':'append'}})
+        state.write(store.manifest,manifest)
+    appended=store.progress(run='run',task=key,after=drained['next_cursor'])
+    assert [r['progress']['value'] for r in appended['items']]==[{'new':'append'}]
+    assert appended['items'][0]['position']==2
+    assert not appended['coverage_assessed']
+    evidence=store.task_evidence(key)
+    result=evidence['attempts'][0]['result']
+    assert base64.b64decode(result['original'])==b'Original findings\x00\r\n'
+    assert result['normalized']['findings'][0]['id']=='F1'
+    assert store.status([spec])['tasks'][0]['reusable']
+    assert len(store.status([])['runs']['run']['progress'])==3
+    assert store.status([],compact=True)['runs']['run']['progress_count']==3
+
+
+def test_cursor_rejects_rewritten_prefix_changed_filter_and_invalid_tokens(case):
+    spec,store=case
+    claim=recorded(store,spec,{'exact':'original'})
+    page=store.progress(run='run')
+    with pytest.raises(ValueError,match='scope'):
+        store.progress(run='run',task=claim['key'],after=page['next_cursor'])
+    with pytest.raises(ValueError,match='cursor'):
+        store.progress(run='run',after='not json!')
+    with store.locked() as manifest:
+        manifest['runs']['run']['progress'][0]['value']['exact']='changed'
+        state.write(store.manifest,manifest)
+    with pytest.raises(ValueError,match='history changed'):
+        store.progress(run='run',after=page['next_cursor'])
+
+
+def test_evidence_preserves_prior_results_and_marks_missing_artifacts(case):
+    spec,store=case
+    first=recorded(store,spec,{'one':1})
+    first_result=store.task_evidence(first['key'])['attempts'][0]['result']
+    Path(spec['instructions']['user']).write_text('Changed current instructions')
+    recorded(store,spec,{'two':2})
+    evidence=store.task_evidence(first['key'])
+    assert len(evidence['attempts'])==2
+    assert evidence['attempts'][0]['result']==first_result
+    Path(first_result['path']).unlink()
+    evidence=store.task_evidence(first['key'])
+    assert evidence['attempts'][0]['problem']=='missing_result_artifact'
+    assert evidence['attempts'][1]['result'] is not None
+    assert evidence['freshness_requires_current_spec']
+
+
+@pytest.mark.parametrize('limit',[0,-1,101,True])
+def test_limits_do_not_mutate_state(case,limit):
+    spec,store=case
+    with pytest.raises(ValueError,match='limit'):
+        store.progress(run='run',limit=limit)
+    assert not store.manifest.exists()
