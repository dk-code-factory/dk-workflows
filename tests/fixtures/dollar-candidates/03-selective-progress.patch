+    def progress(self, *, run, after=None, task=None, limit=20):
+        """Read append-only progress pages; cursors convey no execution authority."""
+        if type(limit) is not int or not 1 <= limit <= 100:
+            raise ValueError('Progress limit must be between 1 and 100')
+        with self.locked() as manifest:
+            if run not in manifest['runs']:
+                raise ValueError('Unknown run id: '+run)
+            if task is not None and task not in manifest['entries']:
+                raise ValueError('Unknown task key: '+task)
+            values = manifest['runs'][run]['progress']
+            offset = 0
+            if after is not None:
+                try:
+                    cursor = json.loads(base64.b64decode(after+'='*((-len(after)) % 4),
+                                                         altchars=b'-_', validate=True))
+                except (ValueError, TypeError) as exc:
+                    raise ValueError('Invalid progress cursor') from exc
+                if (not isinstance(cursor, dict) or set(cursor) != {
+                        'version','subject','run','task','offset','prefix_hash'} or
+                        type(cursor['version']) is not int or cursor['version'] != 1 or
+                        cursor['subject'] != digest(self.subject) or cursor['run'] != run or
+                        cursor['task'] != task or type(cursor['offset']) is not int or
+                        not 0 <= cursor['offset'] <= len(values)):
+                    raise ValueError('Progress cursor scope or position differs')
+                offset = cursor['offset']
+                if cursor['prefix_hash'] != digest(values[:offset]):
+                    raise ValueError('Progress history changed before the cursor; inspect full history')
+            claim_ids = {a['id'] for a in manifest['entries'].get(task, {}).get('attempts', [])} if task else None
+            selected = []
+            start = offset
+            while offset < len(values) and len(selected) < limit:
+                value = values[offset]
+                if claim_ids is None or value.get('claim') in claim_ids:
+                    selected.append({'position':offset,'progress':value})
+                offset += 1
+            cursor = {'version':1,'subject':digest(self.subject),'run':run,'task':task,
+                      'offset':offset,'prefix_hash':digest(values[:offset])}
+            encoded = base64.urlsafe_b64encode(json.dumps(cursor,sort_keys=True).encode()).decode().rstrip('=')
+            return {'page_version':1,'manifest':str(self.manifest),'run':run,'task':task,
+                    'items':selected,'scanned_count':offset-start,'total_progress_count':len(values),
+                    'end_reached':offset == len(values),'next_cursor':encoded,
+                    'coverage_assessed':False}
+
+    def task_evidence(self, key):
+        """Return complete validated original results, including earlier attempts."""
+        with self.locked() as manifest:
+            if key not in manifest['entries']:
+                raise ValueError('Unknown task key: '+key)
+            entry = manifest['entries'][key]
+            attempts = []
+            for attempt in entry.get('attempts', []):
+                filename = attempt.get('result')
+                if filename:
+                    reference = {'file':filename,
+                                 'hash':filename[:-5] if isinstance(filename,str) and filename.endswith('.json') else None,
+                                 'fingerprint':attempt.get('fingerprint')}
+                    result, problem = self._load_saved({'key':key,'result':reference})
+                else:
+                    result, problem = None, 'missing_result'
+                attempts.append({'claim':attempt['id'],'status':attempt.get('status'),
+                                 'handle':attempt.get('handle'),'result':result,'problem':problem})
+            return {'evidence_version':1,'key':key,'manifest':str(self.manifest),
+                    'claim':entry.get('claim'),'attempts':attempts,
+                    'coverage_assessed':False,'freshness_requires_current_spec':True}
+
