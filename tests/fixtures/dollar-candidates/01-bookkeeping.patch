             write(self.manifest, manifest)
             return {'status': status, 'result': str(path), 'reusable': status == 'complete' and captured['cacheable']}
 
+    def _claim_bookkeeping(self, spec, claim_id, value, *, handle):
+        captured = capture(spec)
+        if captured['subject'] != self.subject:
+            raise ValueError('Spec refers to another PR')
+        if not isinstance(value, dict) or not value:
+            raise ValueError('Bookkeeping value must be a nonempty object')
+        if handle and (set(value) != {'host', 'id'} or
+                       any(not isinstance(v, str) or not v.strip() for v in value.values())):
+            raise ValueError('Native handle requires nonempty host and id')
+        with self.locked() as manifest:
+            entry = manifest['entries'].get(captured['key'], {})
+            claim = entry.get('claim')
+            if not claim or claim['id'] != claim_id:
+                raise ValueError('Claim is absent or owned by another attempt')
+            if claim['fingerprint'] != captured['fingerprint']:
+                raise ValueError('Inputs changed during execution; explicitly recover')
+            if handle:
+                if claim.get('handle') and claim['handle'] != value:
+                    raise ValueError('Native handle already retained for this claim')
+                claim['handle'] = value
+                entry['attempts'][-1]['handle'] = value
+            else:
+                if not claim['run']:
+                    raise ValueError('Progress requires a retained run id')
+                manifest['runs'][claim['run']]['progress'].append({'claim': claim_id, 'value': value})
+            write(self.manifest, manifest)
+            return {'manifest': str(self.manifest), 'key': captured['key'],
+                    'claim': claim_id, 'handle' if handle else 'progress': value}
+
+    def save_handle(self, spec, claim_id, value):
+        return self._claim_bookkeeping(spec, claim_id, value, handle=True)
+
+    def append_progress(self, spec, claim_id, value):
+        return self._claim_bookkeeping(spec, claim_id, value, handle=False)
+
     def invalidate(self, keys, reason, *, recover=None):
         if not reason:
             raise ValueError('An invalidation reason is required')
