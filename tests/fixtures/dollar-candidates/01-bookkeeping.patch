+def request(parser, outer, value):
+    if (not isinstance(value, dict) or set(value) != {'version', 'operation', 'arguments'}
+            or type(value['version']) is not int or value['version'] != 1):
+        raise ValueError('Request requires version 1, operation and arguments')
+    operation = value['operation']
+    commands = next(a for a in parser._actions if isinstance(a, argparse._SubParsersAction)).choices
+    if not isinstance(operation, str) or operation not in commands or operation == 'request':
+        raise ValueError('Unknown request operation')
+    arguments = value['arguments']
+    actions = {a.dest: a for a in commands[operation]._actions if a.dest != 'help'}
+    if not isinstance(arguments, dict) or arguments.keys() - actions.keys():
+        raise ValueError('Unknown request arguments')
+    argv = ['--repository', outer.repository, '--pr', outer.pr]
+    if outer.checkout:
+        argv += ['--checkout', str(outer.checkout)]
+    argv.append(operation)
+    for key, action in actions.items():
+        if action.required and key not in arguments:
+            raise ValueError('Missing required argument: '+key)
+        if key not in arguments:
+            continue
+        item = arguments[key]
+        if isinstance(action, argparse._StoreTrueAction):
+            if type(item) is not bool:
+                raise ValueError(key+' must be boolean')
+            if item:
+                argv.append(action.option_strings[0])
+            continue
+        values = item if isinstance(action, argparse._AppendAction) else [item]
+        if not isinstance(values, list) or not values or any(not isinstance(v, str) or not v for v in values):
+            raise ValueError(key+' must contain nonempty strings')
+        for argument in values:
+            if action.choices and argument not in action.choices:
+                raise ValueError('Invalid '+key)
+            argv.append(action.option_strings[0]+'='+argument)
+    return execute(parser.parse_args(argv))
+
+
+def main():
+    parser = make_parser()
+    args = parser.parse_args()
+    if args.command != 'request':
+        print(json.dumps(execute(args), sort_keys=True))
+        return
+    operation = None
+    try:
+        value = read(args.file)
+        operation = value.get('operation') if isinstance(value, dict) else None
+        result = request(parser, args, value)
+        envelope = {'version': 1, 'ok': True, 'operation': operation, 'result': result, 'error': None}
+    except (ValueError, KeyError, TypeError, OSError, RuntimeError) as exc:
+        envelope = {'version': 1, 'ok': False, 'operation': operation, 'result': None,
