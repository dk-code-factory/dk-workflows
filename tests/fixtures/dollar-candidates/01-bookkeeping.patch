new file mode 100644
--- /dev/null
+++ b/tests/test_bookkeeping.py
@@ -0,0 +1,70 @@
+"""Claim-owned bookkeeping and JSON delegation retain existing task guarantees."""
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from test_state import case, done
+
+ROOT = Path(__file__).resolve().parents[1]
+module = importlib.util.spec_from_file_location('dk_bookkeeping', ROOT/'scripts/dk.py')
+dk = importlib.util.module_from_spec(module)
+module.loader.exec_module(dk)
+
+
+def test_handles_progress_and_reuse_preserve_originals(case):
+    spec, store = case
+    start = store.start(spec, run='retained', cycle='c1')
+    claim = start['claim']['id']
+    handle = {'host': 'codex', 'id': 'native-1'}
+    store.save_handle(spec, claim, handle)
+    store.save_handle(spec, claim, handle)
+    with pytest.raises(ValueError, match='already retained'):
+        store.save_handle(spec, claim, {'host': 'codex', 'id': 'another'})
+    progress = {'finding': 'F1', 'acceptance': 'Keep the exact original text.\r\n',
+                'source': spec['pr']+'#issuecomment-9'}
+    store.append_progress(spec, claim, progress)
+    assert store.status([])['unfinished'][0]['handle'] == handle
+    store.record(spec, claim, b'Original findings', {'complete': True, 'findings': ['F1']}, 'complete')
+    assert store.start(spec)['action'] == 'reuse'
+    assert store.status([])['runs']['retained']['progress'][0]['value'] == progress
+    with pytest.raises(ValueError, match='owned'):
+        store.append_progress(spec, claim, progress)
+
+
+def test_bookkeeping_rejects_stale_and_foreign_claims(case):
+    spec, store = case
+    claim = store.start(spec, run='retained')['claim']['id']
+    with pytest.raises(ValueError, match='owned'):
+        store.save_handle(spec, 'wrong', {'host': 'codex', 'id': 'one'})
+    Path(spec['instructions']['user']).write_text('Changed governing instructions')
+    with pytest.raises(ValueError, match='changed'):
+        store.append_progress(spec, claim, {'state': 'complete'})
+    assert len(store.status([])['unfinished']) == 1
+
+
+def test_json_delegates_without_affecting_cli(case, tmp_path):
+    spec, store = case
+    path = tmp_path/'spec.json'; path.write_text(json.dumps(spec))
+    outer = SimpleNamespace(repository=spec['repository'], pr=spec['pr'], checkout=None)
+    request = {'version': 1, 'operation': 'start', 'arguments': {'spec': str(path), 'run': 'run'}}
+    started = dk.request(dk.make_parser(), outer, request)
+    assert started['action'] == 'invoke'
+    request.update(operation='status', arguments={'spec': [str(path)], 'compact': True})
+    assert dk.request(dk.make_parser(), outer, request)['unfinished'][0]['id'] == started['claim']['id']
+
+
+@pytest.mark.parametrize('value', [
+    {}, {'version': True, 'operation': 'status', 'arguments': {}},
+    {'version': 1, 'operation': 'request', 'arguments': {}},
+    {'version': 1, 'operation': 'status', 'arguments': {'typo': True}},
+    {'version': 1, 'operation': 'start', 'arguments': {}},
+    {'version': 1, 'operation': 'status', 'arguments': {'compact': 'yes'}},
+    {'version': 1, 'operation': 'status', 'arguments': {'spec': 'path'}},
+])
+def test_invalid_requests_do_not_mutate(case, value):
+    spec, store = case
+    outer = SimpleNamespace(repository=spec['repository'], pr=spec['pr'], checkout=None)
+    with pytest.raises(ValueError):
+        dk.request(dk.make_parser(), outer, value)
+    assert not store.manifest.exists()
